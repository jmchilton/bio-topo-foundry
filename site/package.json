{
  "name": "topological-data-analysis-bioinformatics-foundry-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "typecheck": "astro check",
    "kinds": "vite-node scripts/generate-kind-manifest.ts",
    "check:kinds": "vite-node scripts/generate-kind-manifest.ts --check",
    "test": "vitest run",
    "audit:citations": "foundry-audit-citations audit --root .. --config audit-citations.config.json --evidence audit/provider-evidence.json --adjudications audit/adjudications.json --output audit/citation-audit.json --markdown audit/citation-audit.md",
    "audit:citations:refresh": "pnpm audit:citations --refresh",
    "audit:citations:scan": "foundry-audit-citations scan --root .. --config audit-citations.config.json --output build/citation-scan.json",
    "validate": "pnpm check:kinds && vitest run && astro check && astro build --force"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@galaxy-foundry/content-reader": "^0.3.0",
    "@galaxy-foundry/kind-manifest": "^0.4.0",
    "@galaxy-foundry/kind-schema": "^0.5.1",
    "@galaxy-foundry/license-policy": "^0.4.1",
    "@galaxy-foundry/reference-contract": "^0.4.0",
    "@galaxy-foundry/site-kit": "^0.9.2",
    "@galaxy-foundry/tag-registry": "^0.1.1",
    "@galaxy-foundry/wiki-links": "^0.4.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.1.6",
    "astro-pagefind": "^2.0.1",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.2",
    "tailwindcss": "4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@galaxy-foundry/audit-citations": "^0.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
