---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import { COLLECTION_NAMES } from '../lib/frontmatter-schema';
import { base } from '../lib/site-base';

// Derived rather than summed by hand: a new collection must not be able to land without the
// headline count following it.
const counts = await Promise.all(
  COLLECTION_NAMES.map(async (collection) => (await getCollection(collection)).length),
);
const typedNoteCount = counts.reduce((total, count) => total + count, 0);
---
<Base title="Topological Data Analysis Bioinformatics Foundry">
  <section class="hero">
    <p class="eyebrow">Frontier → hardening → delivery</p>
    <h1>Topological methods, made runnable.</h1>
    <p class="lede">
      A knowledge base connecting TDA research and software to reproducible bioinformatics
      environments, Galaxy tools, workflows, and training.
    </p>
    <a class="primary-link" href={`${base}/tags/`}>Browse {typedNoteCount} typed notes →</a>
  </section>

  <section class="reference-grid" aria-labelledby="reference-heading">
    <h2 id="reference-heading">Current typed content slice</h2>
    <a class="card" href={`${base}/packages/`}>
      <strong>Packages</strong>
      <span>Profiles of upstream TDA software and the facts needed to harden it.</span>
    </a>
    <a class="card" href={`${base}/environments/`}>
      <strong>Environments</strong>
      <span>Runnable biopixi fixtures, graded L0 to L4 for how portable their packaging is.</span>
    </a>
    <a class="card" href={`${base}/molds/`}>
      <strong>Molds</strong>
      <span>Abstract actions with typed dependencies, ready to become castable artifacts.</span>
    </a>
    <a class="card" href={`${base}/papers/`}>
      <strong>Papers</strong>
      <span>Reviews of external TDA papers and surveys, linked rather than copied.</span>
    </a>
    <a class="card" href={`${base}/replication-experiments/`}>
      <strong>Replication experiments</strong>
      <span>What happened when we ran the papers ourselves, pinned to the evidence.</span>
    </a>
    <a class="card" href={`${base}/methods/`}>
      <strong>Methods</strong>
      <span>The techniques themselves — what each computes, and what implements it here.</span>
    </a>
    <a class="card" href={`${base}/glossary/`}>
      <strong>Glossary</strong>
      <span>The terms that keep the Foundry's content and machinery precise.</span>
    </a>
    <a class="card" href={`${base}/tags/`}>
      <strong>Tags</strong>
      <span>Browse typed notes through the controlled vocabulary they carry.</span>
    </a>
  </section>
</Base>
