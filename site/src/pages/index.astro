---
import FiltrationHero from '../components/FiltrationHero.astro';
import PersistenceDivider from '../components/PersistenceDivider.astro';
import Base from '../layouts/Base.astro';
import { designRecordShelves } from '../lib/design-records';
import { contentReader } from '../lib/content-reader';
import { base } from '../lib/site-base';
import { getEntriesByTag } from '../lib/tags';

const noteTargets = contentReader.noteTargets();
const typedNoteCount = noteTargets.length;

const notesIn = (collection: string) =>
  noteTargets.filter((note) => note.collection === collection).length;

// Counted, not asserted. Nine tiles of one sentence each say the same thing nine times over; the
// size of what is behind each one is the only part that differs, and it is the part a reader is
// deciding on. The glossary is the one destination with nothing to count — a hand-curated page
// rather than a collection — so it carries no figure rather than an invented one.
const slice = [
  {
    path: 'packages',
    title: 'Packages',
    blurb: 'Profiles of upstream TDA software and the facts needed to harden it.',
    count: notesIn('packages'),
    unit: { one: 'profile', many: 'profiles' },
  },
  {
    path: 'environments',
    title: 'Environments',
    blurb: 'Runnable biopixi fixtures, graded L0 to L4 for how portable their packaging is.',
    count: notesIn('environments'),
    unit: { one: 'fixture', many: 'fixtures' },
  },
  {
    path: 'recipes',
    title: 'Recipes',
    blurb: 'In-repo builds for the packages no conda channel carries, and the route out.',
    count: notesIn('recipes'),
    unit: { one: 'build', many: 'builds' },
  },
  {
    path: 'molds',
    title: 'Molds',
    blurb: 'Abstract actions with typed dependencies, ready to become castable artifacts.',
    count: notesIn('molds'),
    unit: { one: 'action', many: 'actions' },
  },
  {
    path: 'papers',
    title: 'Papers',
    blurb: 'Reviews of external TDA papers and surveys, linked rather than copied.',
    count: notesIn('papers'),
    unit: { one: 'review', many: 'reviews' },
  },
  {
    path: 'replication-experiments',
    title: 'Replication experiments',
    blurb: 'What happened when we ran the papers ourselves, pinned to the evidence.',
    count: notesIn('replication-experiments'),
    unit: { one: 'study', many: 'studies' },
  },
  {
    path: 'methods',
    title: 'Methods',
    blurb: 'The techniques themselves — what each computes, and what implements it here.',
    count: notesIn('methods'),
    unit: { one: 'technique', many: 'techniques' },
  },
  {
    path: 'glossary',
    title: 'Glossary',
    blurb: "The terms that keep the Foundry's content and machinery precise.",
  },
  {
    path: 'tags',
    title: 'Tags',
    blurb: 'Browse typed notes through the controlled vocabulary they carry.',
    count: (await getEntriesByTag()).size,
    unit: { one: 'term', many: 'terms' },
  },
] as const;

const recordShelves = await designRecordShelves();
---
<Base title="Topological Data Analysis Bioinformatics Foundry">
  <FiltrationHero noteCount={typedNoteCount} />
  <PersistenceDivider seed="home:frontier-hardening-delivery" />

  <section class="reference-grid" aria-labelledby="reference-heading">
    <h2 id="reference-heading">Current typed content slice</h2>
    {slice.map((destination) => (
      <a class="card" href={`${base}/${destination.path}/`}>
        <strong>{destination.title}</strong>
        <span>{destination.blurb}</span>
        {'count' in destination && (
          <small>
            {destination.count} {destination.count === 1 ? destination.unit.one : destination.unit.many}
          </small>
        )}
      </a>
    ))}
  </section>

  <PersistenceDivider seed="home:the-foundry-itself" />

  {/*
    Its own band rather than one more card above, because the subject changes. Everything in that
    grid is about topological data analysis; these records are about the thing holding it, and a
    reader who wants one almost never wants the other in the same glance.
  */}
  <section class="foundry-record" aria-labelledby="foundry-record-heading">
    <div>
      <p class="eyebrow">The Foundry itself</p>
      <h2 id="foundry-record-heading">Design records</h2>
      <p>
        Why this Foundry is shaped the way it is, and how it is built. Records are typed notes like
        any other, split across two shelves: foundation records argue, infrastructure records
        describe.
      </p>
    </div>
    <ul>
      {recordShelves.map(({ shelf, title, records }) => (
        <li>
          <a href={`${base}/design/#shelf-${shelf}`}>
            <strong>{title}</strong>
            <span>{records.length} {records.length === 1 ? 'record' : 'records'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
