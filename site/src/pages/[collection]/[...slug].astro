---
import { getCollection, render } from 'astro:content';
import ContentNote from '@galaxy-foundry/site-kit/ContentNote.astro';
import LicenseBadge from '@galaxy-foundry/site-kit/LicenseBadge.astro';
import ReferenceContract from '@galaxy-foundry/site-kit/ReferenceContract.astro';

import Base from '../../layouts/Base.astro';
import { environmentCompanions } from '../../lib/companions';
import { contentReader } from '../../lib/content-reader';
import { DETAIL_ROUTES } from '../../lib/detail-routes';
import { licensePolicy } from '../../lib/registries';
import { referenceContract } from '../../lib/reference-contract';
import { base } from '../../lib/site-base';

export async function getStaticPaths() {
  // Written out so Astro retains a discriminated union of the frontmatter shapes. A collection
  // missing here still builds its index page, so the omission shows up only as absent detail
  // pages — which is what the routed-note coverage check in built-site.test.ts exists to catch.
  const entries = [
    ...(await getCollection('environments')),
    ...(await getCollection('methods')),
    ...(await getCollection('molds')),
    ...(await getCollection('papers')),
    ...(await getCollection('packages')),
    ...(await getCollection('replication-experiments')),
  ];
  return entries.map((entry) => ({
    params: { collection: entry.collection, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const route = DETAIL_ROUTES[entry.collection];
const companions = entry.collection === 'environments' ? environmentCompanions(entry.id) : [];
const heading = entry.collection === 'molds' ? entry.data.name : entry.data.title;
const resolveRef = (ref: string) => contentReader.resolveLink(ref, { base });
---
<Base title={heading} description={entry.data.summary}>
  <ContentNote
    title={heading}
    summary={entry.data.summary}
    tags={entry.data.tags}
    tagBase={`${base}/tags`}
    back={{ href: `${base}/${entry.collection}/`, label: route.label }}
    articleClass="prose"
  >
    {entry.collection === 'packages' && (
      <aside slot="metadata" class="note-facts" aria-label="Package facts">
        <div>
          <span>Repository</span>
          <a href={entry.data.repository}>{new URL(entry.data.repository).host}</a>
        </div>
        <div>
          <span>Language</span>
          <strong>{entry.data.languages.join(', ')}</strong>
        </div>
        <div>
          <span>Software license</span>
          {entry.data.software_license.status === 'declared'
            ? <LicenseBadge license={entry.data.software_license.id} policy={licensePolicy} />
            : <strong>Not declared upstream</strong>}
        </div>
      </aside>
    )}

    {entry.collection === 'papers' && (
      <aside slot="metadata" class="note-facts" aria-label="Source facts">
        <div class="note-facts-wide">
          <span>Reviewed work</span>
          <cite>{entry.data.citation}</cite>
        </div>
        <div>
          <span>Source</span>
          <a href={entry.data.source_url}>{new URL(entry.data.source_url).host}</a>
        </div>
        <div>
          <span>Source license</span>
          {entry.data.source_license.status === 'declared'
            ? <LicenseBadge license={entry.data.source_license.id} policy={licensePolicy} />
            : <strong>Not declared by the source</strong>}
        </div>
        <div>
          <span>Summary posture</span>
          <strong>
            {entry.data.derived === 'own-words-summary'
              ? 'Own words'
              : 'License-aware, with quotation'}
          </strong>
        </div>
      </aside>
    )}

    {entry.collection === 'methods' && (
      <aside slot="metadata" class="note-facts" aria-label="Method facts">
        <div class="note-facts-wide">
          <span>Anchors the tag</span>
          <a href={`${base}/tags/${entry.data.facet_tag}/`}><code>{entry.data.facet_tag}</code></a>
        </div>
      </aside>
    )}

    {entry.collection === 'replication-experiments' && (
      <aside slot="metadata" class="note-facts" aria-label="Replication facts">
        <div>
          <span>Status</span>
          <strong>{entry.data.status}</strong>
        </div>
        <div>
          <span>Arc</span>
          <strong>{entry.data.arc.join(' → ')}</strong>
        </div>
        <div>
          <span>Outcome</span>
          <strong>{entry.data.replication_outcome?.replace(/_/g, ' ') ?? 'Not yet recorded'}</strong>
        </div>
        <div>
          <span>Redistribution</span>
          <strong>{entry.data.redistribution}</strong>
        </div>
        <div class="note-facts-wide">
          <span>Pinned evidence</span>
          <a href={`${entry.data.artifact.repository}/tree/${entry.data.artifact.revision}`}>
            <code>{new URL(entry.data.artifact.repository).pathname.slice(1)}@{entry.data.artifact.revision.slice(0, 12)}</code>
          </a>
        </div>
        <div class="note-facts-wide">
          <span>Rerun environment</span>
          {entry.data.environment
            ? <a href={`${base}/environments/${entry.data.environment}/`}>{entry.data.environment}</a>
            : <strong>None yet — no biopixi rerun recorded here</strong>}
        </div>
      </aside>
    )}

    {entry.collection === 'environments' && (
      <aside slot="metadata" class="note-facts" aria-label="Fixture facts">
        <div>
          <span>Portability grade</span>
          <strong data-grade={entry.data.portability_grade}>{entry.data.portability_grade}</strong>
        </div>
        <div class="note-facts-wide">
          <span>Manifest files</span>
          <ul class="companion-list">
            {companions.map(({ companion, present }) => (
              <li data-present={String(present)}>
                <code>{companion.name}</code>
                <span>{present ? 'present' : `absent (${companion.requirement})`}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}

    {entry.collection === 'molds' && (
      <ReferenceContract
        slot="reference"
        references={entry.data.references ?? []}
        contract={referenceContract()}
        resolveRef={resolveRef}
      />
    )}

    <Content />
  </ContentNote>
</Base>
