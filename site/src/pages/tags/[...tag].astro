---
import { facetLabelOf } from '@galaxy-foundry/tag-registry';

import PersistenceDivider from '../../components/PersistenceDivider.astro';
import PointCloudFingerprint from '../../components/PointCloudFingerprint.astro';
import Base from '../../layouts/Base.astro';
import { tagRegistry } from '../../lib/meta-tags';
import { base } from '../../lib/site-base';
import { getEntriesByTag, type TaggedEntry } from '../../lib/tags';

export async function getStaticPaths() {
  const byTag = await getEntriesByTag();
  return [...byTag].map(([tag, entries]) => ({ params: { tag }, props: { tag, entries } }));
}

const { tag, entries } = Astro.props as { tag: string; entries: TaggedEntry[] };
const registry = tagRegistry();
const description = registry.tagDescription(tag);
const facetLabel = facetLabelOf(registry, tag);
const anchor = entries.find((entry) => entry.anchorTag === tag);
const related = entries
  .filter((entry) => entry !== anchor)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base title={`Tag: ${tag}`} description={description}>
  <header class="page-header tag-heading">
    <a href={`${base}/tags/`}>← All tags</a>
    <p class="eyebrow">{facetLabel}</p>
    <h1>{tag}</h1>
    {description && <p>{description}</p>}
  </header>
  <PersistenceDivider seed={`tag:${tag}`} />

  {anchor && (
    <section class="tag-results" aria-labelledby="tag-guide">
      <h2 id="tag-guide">{anchor.kind} guide</h2>
      <ul class="collection-list">
        <li>
          <a class="card" href={anchor.url}>
            <span class="card-title-row">
              <strong>{anchor.name}</strong>
              <PointCloudFingerprint seed={`${anchor.kind}:${anchor.id}:${anchor.tags.join('|')}`} />
            </span>
            <span>{anchor.summary}</span>
            <small>{anchor.kind}</small>
          </a>
        </li>
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="tag-results" aria-labelledby="tagged-notes">
      <h2 id="tagged-notes">{anchor ? 'Related notes' : 'Notes'}</h2>
      <ul class="collection-list">
        {related.map((entry) => (
          <li>
            <a class="card" href={entry.url}>
              <span class="card-title-row">
                <strong>{entry.name}</strong>
                <PointCloudFingerprint seed={`${entry.kind}:${entry.id}:${entry.tags.join('|')}`} />
              </span>
              <span>{entry.summary}</span>
              <small>{entry.kind}</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
