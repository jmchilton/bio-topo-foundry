---
import { getCollection } from 'astro:content';
import TagChips from '@galaxy-foundry/site-kit/TagChips.astro';

import PersistenceDivider from '../../components/PersistenceDivider.astro';
import PointCloudFingerprint from '../../components/PointCloudFingerprint.astro';
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/site-base';

const packages = (await getCollection('packages')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---
<Base title="Packages" description="Typed profiles of upstream TDA software projects.">
  <header class="page-header">
    <p class="eyebrow">Software</p>
    <h1>Packages</h1>
    <p>
      A Package is the software project we study and harden. Runnable environments and build
      recipes are related artifacts, not part of the package's identity.
    </p>
  </header>
  <PersistenceDivider seed="collection:packages" />

  <ul class="collection-list">
    {packages.map((entry) => (
      <li class="card">
        <a class="card-primary" href={`${base}/packages/${entry.id}/`}>
          <span class="card-title-row">
            <strong>{entry.data.title}</strong>
            <PointCloudFingerprint seed={`package:${entry.id}:${entry.data.tags.join('|')}`} />
          </span>
          <span>{entry.data.summary}</span>
        </a>
        <TagChips tags={entry.data.tags} tagBase={`${base}/tags`} />
      </li>
    ))}
  </ul>
</Base>
