---
import { getCollection, render } from 'astro:content';
import LicenseBadge from '@galaxy-foundry/site-kit/LicenseBadge.astro';
import ContentNote from '@galaxy-foundry/site-kit/ContentNote.astro';

import Base from '../../layouts/Base.astro';
import { licensePolicy } from '../../lib/registries';
import { base } from '../../lib/site-base';

export async function getStaticPaths() {
  return (await getCollection('packages')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const license = entry.data.software_license;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <ContentNote
    title={entry.data.title}
    summary={entry.data.summary}
    tags={entry.data.tags}
    tagBase={`${base}/tags`}
    back={{ href: `${base}/packages/`, label: 'Packages' }}
    articleClass="prose"
  >
    <aside slot="metadata" class="package-facts" aria-label="Package facts">
      <div>
        <span>Repository</span>
        <a href={entry.data.repository}>{new URL(entry.data.repository).host}</a>
      </div>
      <div>
        <span>Language</span>
        <strong>{entry.data.languages.join(', ')}</strong>
      </div>
      <div>
        <span>Software license</span>
        {license.status === 'declared'
          ? <LicenseBadge license={license.id} policy={licensePolicy} />
          : <strong>Not declared upstream</strong>}
      </div>
    </aside>

    <Content />
  </ContentNote>
</Base>
