---
import { getCollection } from 'astro:content';
import TagChips from '@galaxy-foundry/site-kit/TagChips.astro';

import Base from '../../layouts/Base.astro';
import { base } from '../../lib/site-base';

const studies = (await getCollection('replication-experiments')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---
<Base title="Replication experiments" description="Studies this Foundry ran to test the claims of external TDA papers and software.">
  <header class="page-header">
    <p class="eyebrow">Our evidence</p>
    <h1>Replication experiments</h1>
    <p>
      Everywhere else in this corpus the subject is someone else's work. Here it is what happened
      when we ran it. Each note pins one revision of a standalone repository, reports what
      reproduced and what did not, and says what remains before the study could be called complete.
    </p>
  </header>

  <ul class="collection-list">
    {studies.map((entry) => (
      <li class="card">
        <a class="card-primary" href={`${base}/replication-experiments/${entry.id}/`}>
          <strong>{entry.data.title}</strong>
          <span>{entry.data.summary}</span>
        </a>
        <TagChips tags={entry.data.tags} tagBase={`${base}/tags`} />
      </li>
    ))}
  </ul>
</Base>
